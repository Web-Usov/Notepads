{
  "apiVersion": 2,
  "version": "1.1.1",
  "id": "notepads.json",
  "displayName": "JSON",
  "contributes": {
    "commands": [
      {
        "id": "format",
        "title": "Format JSON",
        "titleTranslations": { "ru": "Форматировать JSON" },
        "handler": "json.format",
        "fileExtensions": [".json"]
      },
      {
        "id": "minify",
        "title": "Minify JSON",
        "titleTranslations": { "ru": "Сжать JSON" },
        "handler": "json.minify",
        "fileExtensions": [".json"]
      }
    ],
    "grammars": [
      {
        "fileExtensions": [
          ".json"
        ],
        "rules": [
          {
            "scope": "property",
            "match": "\"(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])*\"(?=[ \\t\\r\\n]*:)"
          },
          {
            "scope": "string",
            "match": "\"(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])*(?:\"|\\\\?(?=\\r|\\n|\\z))"
          },
          {
            "scope": "number",
            "match": "(?<![\\w.+-])-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?(?![\\w.])"
          },
          {
            "scope": "keyword",
            "match": "(?<!\\w)(?:true|false|null)(?!\\w)"
          },
          {
            "scope": "punctuation",
            "match": "[{}\\[\\],:]"
          }
        ]
      }
    ]
  }
}
